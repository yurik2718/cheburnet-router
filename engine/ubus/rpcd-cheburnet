#!/usr/bin/ucode -R
// rpcd-cheburnet — ubus-RPC обработчик движка для веб-мастера (ИМПУРНЫЙ слой, наследник
// v1 web/rpcd-cheburnet). Ставится в /usr/libexec/rpcd/cheburnet, rpcd подхватывает сам.
//
// Протокол rpcd: вызывается как `list` (печатает дескриптор методов) или `call <method>`
// (аргументы метода приходят JSON'ом на stdin). В shebang `-R` — иначе ucode на OpenWrt
// читает файл как ШАБЛОН (default там — template-режим) и печатает код буквально.
//
// РОЛЬ: тонкий фасад. Валидация входа и роутинг — ЧИСТОЕ ядро ubus.uc (под юнит-тестами,
// граница доверия). Здесь — только I/O: запуск движковых CLI (preflight/install/run/list/
// шаги) и фон+poll установки. Логику НЕ дублируем — переиспользуем install/run.uc,
// preflight, list, steps. Проверяется в QEMU (живой ubus/uci), не юнитами.

import { stdin, readfile, writefile, unlink, access, chmod, mkdir } from "fs";
import { sh, run_stdin, shellquote } from "../lib/proc.uc";
import { list_descriptor, validate_request, requires_token, make_error } from "./ubus.uc";
import { cidr_overlap, suggest_lan, valid_lan_ip, full_hw_missing } from "../preflight/preflight.uc";
import { default_provider, describe, catalog_for_ui } from "../steps/doh/providers.uc";
import { owned_sections as dns_owned_sections } from "../steps/dns/dns.uc";
import { default_protocol, tunnel_info, tunnel_health, uses_singbox } from "../install/install.uc";
import { restart_tunnel_cmd } from "../watchdog/watchdog.uc";

// engine/ — относительно этого файла (engine/ubus/rpcd-cheburnet). Тот же приём, что в run.uc.
// ENGINE_DIR — override ТОЛЬКО для host-тестов: длинные операции подменяются заглушками.
const ENGINE = getenv("ENGINE_DIR") ?? (sourcepath(0, true) + "/..");

// Пути роутера. env-override — чтобы integration-тесты гоняли скрипт в sandbox без реальных
// /etc и /tmp (тот же приём, что в v1).
const STATE_DIR     = getenv("STATE_DIR")     ?? "/tmp/cheburnet";
const ETC_CHEBURNET = getenv("ETC_CHEBURNET") ?? "/etc/cheburnet";
const TOKEN_FILE    = ETC_CHEBURNET + "/install-token";
const CFG_FILE      = ETC_CHEBURNET + "/install.json"; // воспроизводимая конфигурация (без секретов)
const PAYLOAD_FILE  = STATE_DIR + "/install-payload.json"; // вход для run.uc (содержит awg_conf → 600)
const LOG_FILE      = STATE_DIR + "/install.log";
const STATE_FILE    = STATE_DIR + "/state";
const DONE_FILE     = STATE_DIR + "/done";
const REASON_FILE   = STATE_DIR + "/reason"; // машинный код исхода (decide_outcome.code) для UI
const PID_FILE      = STATE_DIR + "/pid";

// === I/O-хелперы === (sh/run_stdin — общие, см. lib/proc.uc)

// respond(obj) — напечатать JSON-ответ RPC и выйти 0 (rpcd ждёт один JSON-объект в stdout).
function respond(obj) {
	print(sprintf("%J\n", obj));
	exit(0);
}

// pid_alive() — идёт ли уже фоновая операция (install/run.uc). kill -0 через shell.
// DONE-маркер проверяем ПЕРВЫМ: PID-файл после завершения операции не чистится, и когда ядро
// переиспользует pid (wrap-around) для чужого долгоживущего процесса, kill -0 отвечал бы «жив»
// вечно — все мутации отбивались бы «операция уже выполняется» до ребута. done есть → операция
// завершена, чей бы процесс ни носил этот pid сейчас (spawn_bg снимает done перед новой).
function pid_alive() {
	if (access(DONE_FILE)) return false;
	let pid = trim(readfile(PID_FILE) ?? "");
	if (length(pid) == 0) return false;
	return trim(sh(sprintf("kill -0 %s 2>/dev/null; echo $?", pid))) == "0";
}

function engine_cli(rel) { return sprintf("ucode -R %s/%s", ENGINE, rel); }

// load_cfg() — воспроизводимая конфигурация (domains/user_domains/routing_opts), сохранённая
// при установке. Нет файла → пустой дефолт (set_mode/update_list тогда работают по home-дефолту).
function load_cfg() {
	let raw = readfile(CFG_FILE);
	let c = (raw && substr(trim(raw), 0, 1) == "{") ? json(raw) : {};
	if (type(c.routing_opts) != "object") c.routing_opts = {};
	if (type(c.domains) != "array") c.domains = [];
	if (type(c.user_domains) != "array") c.user_domains = [];
	if (type(c.dns_provider) != "string") c.dns_provider = default_provider();
	if (type(c.protocol) != "string") c.protocol = default_protocol();
	if (type(c.forced) != "array") c.forced = [];
	if (type(c.paused) != "bool") c.paused = false;
	return c;
}

function save_cfg(c) {
	writefile(CFG_FILE, sprintf("%J\n", {
		user_domains: c.user_domains, domains: c.domains,
		routing_opts: c.routing_opts, dns_provider: c.dns_provider,
		protocol: c.protocol, // туннель (awg|reality) — не секрет, нужен status/reset
		// forced ОБЯЗАН переживать перезапись cfg (смена режима/списка/провайдера): иначе отметка
		// «поставлено с пропуском проверок железа» тихо исчезала бы после первого же set_mode.
		forced: (type(c.forced) == "array") ? c.forced : [],
		// paused ОБЯЗАН пережить перезапись cfg (смена режима/списка/провайдера): иначе первый же
		// set_mode стёр бы аварийный режим, reapply вернул бы защиту — и человек снова остался бы
		// без интернета, ничего для этого не сделав.
		paused: (c.paused === true),
	}));
}

// accepted_risk(cfg) — этот роутер УЖЕ поставлен с пропуском soft-проверок железа?
// Операции, которые переиспользуют run.uc (switch_to_reality/awg), проходят preflight ЗАНОВО —
// без этого флага они бы упирались в тот же отказ, и владелец, однажды осознанно согласившийся
// на слабое железо, не смог бы сменить туннель из панели. Решение уже принято — не спрашиваем дважды.
function accepted_risk(cfg) {
	return length(cfg.forced ?? []) > 0;
}

// imported_text() — кэш community-списка (заполняет list/fetch.uc). Нет файла → пусто.
function imported_text() {
	return readfile(ETC_CHEBURNET + "/direct-list") ?? "";
}

// assemble_domains(user) — финальный direct-список: user + community-кэш, через чистое ядро
// list/assemble.uc (валидация/дедуп там). Возврат — массив доменов (пустой при сбое: fail-safe,
// промах → трафик в туннель).
function assemble_domains(user) {
	let req = sprintf("%J", { user: user ?? [], imported_text: imported_text() });
	let out = sh(sprintf("printf '%%s' %s | %s", shellquote(req), engine_cli("list/assemble.uc")));
	let r = (substr(trim(out), 0, 1) == "{") ? json(out) : {};
	return (type(r.domains) == "array") ? r.domains : [];
}

// reapply_dns(cfg) — переприменить DNS-шаг его же apply.uc (идемпотентно). Firewall так НЕ
// переприменяем: у него есть единственная реализация install/reapply.uc (свежий WAN, tunnel_if по
// протоколу) — собственная копия здесь однажды пересобрала NAT-зону Full-тира под awg0.
function reapply_dns(cfg) {
	let payload = sprintf("%J", { domains: cfg.domains, routing_opts: cfg.routing_opts });
	return run_stdin(engine_cli("steps/dns/apply.uc"), payload);
}

// Человеческое имя протокола для сообщений об ошибках (панель показывает их как есть).
const PROTO_NAMES = { awg: "AmneziaWG", reality: "VLESS+Reality", hysteria2: "Hysteria2" };
function proto_name(p) {
	return PROTO_NAMES[p] ?? (p ?? "?");
}

// validate_tunnel_conf(protocol, conf) → { ok, error } — СИНХРОННАЯ проверка туннель-конфига
// ДО фона: битый вход отбиваем сразу, с ПОНЯТНОЙ причиной, а не заставляя пользователя ждать
// провала всей установки и читать лог. Full-протоколы: собираем ERROR-строки singbox/plan.uc
// точечно («нет pbk», «obfs без пароля», «pinSHA256 не поддерживается»); awg: генерик (INI-конфиг
// обычно бит целиком) — как в replace_awg_conf.
// Ветвимся по uses_singbox, а не по имени: один валидатор на все протоколы Full-тира.
function validate_tunnel_conf(protocol, conf) {
	if (uses_singbox(protocol)) {
		let expect = (protocol == "hysteria2")
			? "нужна ссылка hysteria2://… или JSON-конфиг sing-box"
			: "нужна ссылка vless://… или JSON-конфиг sing-box";
		if (length(trim(conf ?? "")) == 0)
			return { ok: false, error: expect };
		// Секрет (credentials сервера) → 600-temp, чистим сразу. plan.uc печатает ERROR: <причина>
		// и выходит 1; ловим и код, и текст.
		let tmp = STATE_DIR + "/tunnel-validate.txt";
		writefile(tmp, conf);
		chmod(tmp, 0o600);
		let out = sh(sprintf("%s < %s 2>&1; echo __rc=$?", engine_cli("steps/singbox/plan.uc"), tmp));
		unlink(tmp);
		let rc = match(out, /__rc=([0-9]+)/);
		if (rc && rc[1] == "0")
			return { ok: true };
		let msgs = [], lines = split(out, "\n");
		for (let i = 0; i < length(lines); i++) {
			let m = match(trim(lines[i]), /^ERROR: (.+)$/);
			if (m) push(msgs, m[1]);
		}
		return { ok: false, error: length(msgs) > 0
			? sprintf("ссылка %s не разобрана: %s", proto_name(protocol), join("; ", msgs))
			: sprintf("ссылка %s не разобрана — проверьте, что вставлена целиком", proto_name(protocol)) };
	}
	// awg (Light): sync-валидация через vpn/plan.uc (генерик-сообщение достаточно).
	let rc = run_stdin(engine_cli("steps/vpn/plan.uc") + " >/dev/null 2>&1", conf ?? "");
	return rc == 0 ? { ok: true }
		: { ok: false, error: "AWG-конфиг не разобран — проверьте, что вставлен целиком" };
}

// check_token(v) — гейт pre-install мутаций: сверить значение токена с файлом bootstrap'а.
// Не вернулось → respond уже отдал ошибку (функция не возвращается при провале).
function check_token(v) {
	let expected = trim(readfile(TOKEN_FILE) ?? "");
	if (length(expected) == 0)
		respond(make_error("install-токен не найден — запустите bootstrap по SSH (или роутер уже настроен)"));
	if (trim(v.token) != expected)
		respond(make_error("неверный install-токен — см. вывод bootstrap"));
}

// spawn_bg(cmd, state) — длинная операция в фоне: setsid отвязывает от rpcd-сессии (SIGHUP при
// её закрытии иначе убьёт работу до записи done), код выхода → done-маркер, прогресс — через
// install_progress (общий PID-файл = взаимное исключение длинных операций). Паттерн v1.
function spawn_bg(cmd, state) {
	unlink(DONE_FILE); unlink(LOG_FILE); unlink(REASON_FILE);
	writefile(STATE_FILE, state + "\n");
	// STATE_FILE/REASON_FILE в env: длинная операция (run.uc) обновляет первый именем текущего
	// шага («Шаг: vpn/dns/firewall…»), во второй пишет машинный код исхода при провале — UI
	// говорит адресно («VPN-сервер не ответил» ≠ «упал шаг»). Кто env игнорирует (reset) —
	// просто не пишет, поведение прежнее.
	// rm -f payload ДО done-маркера: файл несёт секреты (awg-ключ, root-пароль, reality-
	// credentials) и нужен только как stdin длинной операции — после её конца не оставляем
	// секреты лежать в /tmp до ребута. -f: операций без payload (reset, install-full) это не касается.
	let spawn = sprintf(
		"STATE_FILE=%s REASON_FILE=%s setsid sh -c '%s >> %s 2>&1; rc=$?; rm -f %s; echo $rc > %s' </dev/null >/dev/null 2>&1 & echo $!",
		STATE_FILE, REASON_FILE, cmd, LOG_FILE, PAYLOAD_FILE, DONE_FILE);
	let pid = trim(sh(spawn));
	writefile(PID_FILE, pid + "\n");
	return int(pid);
}

// === методы ===

function m_preflight() {
	// gather (router-side факты) → check --json (чистый вердикт). Возвращаем отчёт как есть.
	let report = sh(sprintf("%s | %s --json", engine_cli("preflight/gather.uc"), engine_cli("preflight/check.uc")));
	if (substr(trim(report), 0, 1) != "{")
		respond(make_error("preflight: не удалось собрать факты"));
	respond(json(report));
}

function m_status() {
	let cfg = load_cfg();
	let mode = cfg.routing_opts.mode ?? "home";

	let installed = access(ETC_CHEBURNET + "/install.json") ? true : false;

	// Все системные факты — ОДНИМ popen (UI поллит status каждые 15 с; на слабом железе
	// отдельные форки на каждый опрос — лишний налог). Батч печатает строки key=value;
	// значения однострочны (uci-список — одна строка, awk NR==1 — первый peer).
	let probe =
		sprintf("echo \"direct=$(uci -q get dhcp.%s.domain 2>/dev/null)\"; ",
			dns_owned_sections(null)[0]) +
		"echo \"hs=$(awg show awg0 latest-handshakes 2>/dev/null | awk 'NR==1{print $2}')\"; " +
		"echo \"dns=$(/etc/init.d/dnsmasq status 2>/dev/null | grep -qi running && echo up)\"; " +
		"echo \"doh=$(/etc/init.d/https-dns-proxy status 2>/dev/null | grep -qi running && echo up)\"; " +
		"echo \"radios=$(uci -q show wireless 2>/dev/null | grep -c '=wifi-device')\"; " +
		"echo \"ssid=$(uci -q get wireless.@wifi-iface[0].ssid 2>/dev/null)\"; " +
		// Full-тир (opt-in): бинарь sing-box стоит? + arch/ram для «потянет ли» (лёгкая проверка
		// для видимости кнопки; авторитетный гейт — preflight при установке). arch — прокси AES.
		"echo \"sbx=$(command -v sing-box)\"; " +
		// Здоровье АКТИВНОГО туннеля (awg0 | singtun0 — имя из tunnel_info, не хардкод): процесс
		// sing-box жив и TUN поднят. Для Reality это единственный ДЕШЁВЫЙ признак — рукопожатия у
		// него нет, а connectivity-probe (пин host-route + fetch) слишком дорог для поллинга.
		// БЕЗ -x: busybox-pgrep сверяет argv[0] как запущено, а procd стартует демон по
		// абсолютному пути — `pgrep -x sing-box` не совпадёт никогда, и панель показала бы
		// «VPN не работает» на рабочем Reality (тот самый баг, ради которого признак и заводили).
		"echo \"sbxrun=$(pgrep sing-box >/dev/null 2>&1 && echo up)\"; " +
		// Флаг UP в скобках `<…,UP,…>`, а НЕ `state UP` и не фильтр `ip link show … up`: у TUN-
		// устройства state=UNKNOWN, а фильтр `up` — синтаксис iproute2 (busybox ip его не знает).
		// Промах здесь = ложное «туннель не поднят» на рабочем Reality, то есть тот же баг обратно.
		sprintf("echo \"tunup=$(ip link show dev %s 2>/dev/null | grep -qE '[<,]UP[,>]' && echo up)\"; ",
			tunnel_info(cfg.protocol).tunnel_if) +
		"echo \"march=$(uname -m)\"; " +
		// $2 внутри одинарных кавычек awk НЕ экранировать: busybox awk прощал '\$2', а GNU и
		// другие awk на нём падают → mram пуст → full_capable ложно false (поймано тестом на хосте).
		"echo \"mram=$(awk '/MemTotal/{print int($2/1024)}' /proc/meminfo 2>/dev/null)\"; " +
		// Свободный флеш (МБ) для гейта кнопки Full-тира: sing-box ~42 МБ (замер qemu-reality),
		// и раньше кнопка флеш ИГНОРИРОВАЛА — обещала то, что валилось на apk.
		// Available = ТРЕТЬЕ целое поле строки данных, счётчик НЕ сбрасываем по строкам: так же,
		// как parse_df, это переживает busybox-перенос длинного имени ФС на отдельную строку.
		// $i внутри одинарных кавычек awk НЕ экранировать (урок mram: GNU awk на '\$i' падает).
		"echo \"mfree=$( (df -k /overlay 2>/dev/null || df -k /) | " +
		"awk 'NR>1{for(i=1;i<=NF;i++) if ($i ~ /^[0-9]+$/) {n++; if (n==3) {print int($i/1024); exit}}}' )\"; " +
		// Пустой pid ОБЯЗАТЕЛЬНО отсекаем ДО kill: busybox парсит "" как 0 → kill(0,0) —
		// сигнал собственной process-группе → всегда успех → ложный installing=true.
		// Хостовый shell на "" отвечает ошибкой — юниты этот gap не видят (поймано в QEMU).
		// done-маркер гасит kill -0 по той же причине, что в pid_alive: переиспользованный pid.
		sprintf("[ ! -f %s ] && p=$(cat %s 2>/dev/null); [ -n \"$p\" ] && kill -0 \"$p\" 2>/dev/null && echo alive=1", DONE_FILE, PID_FILE);
	let facts = {};
	let plines = split(sh(probe), "\n");
	for (let i = 0; i < length(plines); i++) {
		let eq = index(plines[i], "=");
		if (eq > 0) facts[substr(plines[i], 0, eq)] = trim(substr(plines[i], eq + 1));
	}

	// Кол-во direct-доменов: список domain нашей v4 ipset-секции (имя — из dns.owned_sections,
	// не хардкод). uci get списка отдаёт элементы через пробел.
	let dtoks = split(facts.direct ?? "", /[ \t]+/);
	let direct_count = 0;
	for (let i = 0; i < length(dtoks); i++)
		if (length(dtoks[i]) > 0) direct_count++;

	// AWG handshake: возраст последнего рукопожатия (сек) или null. time() — без форка date.
	let hs_age = null;
	let hs = facts.hs ?? "";
	if (match(hs, /^[0-9]+$/) && int(hs) > 0)
		hs_age = time() - int(hs);

	// Здоровье туннеля ОДНИМ признаком для любого протокола — чистая tunnel_health (install.uc,
	// под юнитами). Панель ветвит текст по protocol, но «работает / не работает» берёт отсюда:
	// раньше она судила по AWG-рукопожатию и на живом Reality честно врала «VPN не работает».
	let tun_health = tunnel_health(cfg.protocol, {
		hs_age: hs_age,
		sb_running: (facts.sbxrun ?? "") == "up",
		tun_up: (facts.tunup ?? "") == "up",
	});

	// Wi-Fi: есть ли радио (wifi-device) и текущий SSID первой секции wifi-iface. UI по
	// wireless_present решает, показывать ли экран Wi-Fi (wired-only роутеры его не получают).
	let wireless_present = (match(facts.radios ?? "", /^[0-9]+$/) && int(facts.radios) > 0);
	let ssid = facts.ssid ?? "";

	// DNS-провайдер (= уровень фильтрации) из воспроизводимой конфигурации + каталог для UI.
	let dns_provider = cfg.dns_provider;

	// Full-тир (opt-in): full_installed — бинарь sing-box стоит (можно предлагать Reality);
	// full_capable — железо потянет (показать кнопку «включить»). Логика гейта железа — чистая
	// full_hw_missing (единый источник с preflight, под юнит-тестами: границы RAM/флеша, мусор из
	// батча). Она же отдаёт СПИСОК причин, чтобы панель называла, чего не хватает.
	let full_installed = length(facts.sbx ?? "") > 0;
	let full_missing = full_hw_missing(facts.march, facts.mram, facts.mfree, null);
	let full_capable = length(full_missing) == 0;

	// Здоровье импортированного списка: кэш community-списка direct-доменов (list/fetch.uc).
	// Пустой/отсутствующий кэш — повод для баннера в UI (direct-домены поедут через туннель —
	// fail-safe, но пользователь должен знать).
	let imported = imported_text();
	let imported_domains = 0;
	let ilines = split(imported, "\n");
	for (let i = 0; i < length(ilines); i++) {
		let l = trim(ilines[i]);
		if (length(l) > 0 && substr(l, 0, 1) != "#") imported_domains++;
	}

	respond({
		installed: installed,
		// Аварийный режим: панель обязана сказать прямо, что защита сейчас снята (см. pause.uc).
		paused: (cfg.paused === true),
		installing: (facts.alive ?? "") == "1",
		mode: mode,
		protocol: cfg.protocol, // активный туннель (awg|reality) — UI показывает и предлагает замену

		direct_domains: direct_count,
		// Здоровье туннеля — протокол-независимо ("up"|"down"); панель судит по нему.
		// awg_handshake_age остаётся рядом: у AWG он несёт БОЛЬШЕ (сервер отвечал N сек назад),
		// у reality он всегда null — рукопожатия у VLESS нет, и это не признак поломки.
		tunnel_health: tun_health,
		awg_handshake_age: hs_age,
		dns_up: (facts.dns ?? "") == "up",
		doh_up: (facts.doh ?? "") == "up",
		wireless_present: wireless_present,
		ssid: ssid,
		dns_provider: dns_provider,
		dns_provider_desc: describe(dns_provider),
		dns_providers: catalog_for_ui(),
		direct_list_loaded: imported_domains > 0,
		imported_domains: imported_domains,
		full_capable: full_capable,      // железо потянет Full → показать кнопку включения
		// ЧЕГО не хватает для Full ("arch"|"ram"|"flash"): панель говорит причину, а не молча
		// прячет кнопку — иначе человек не понимает, почему у него нет описанной в docs функции.
		full_missing: full_missing,
		full_installed: full_installed,  // sing-box стоит → можно предлагать/переключать на Reality
		// Проверки железа, пропущенные владельцем при установке (run.uc пишет в install.json).
		// Панель показывает по ним честную плашку «стабильность не гарантируется» — и это же
		// первое, что видно в присланном скриншоте статуса при разборе жалоб.
		forced: (type(cfg.forced) == "array") ? cfg.forced : [],
	});
}

function m_install(v) {
	if (pid_alive())
		respond(make_error("операция уже выполняется"));

	// Токен уже сверен центральным гейтом диспетчера (requires_token из REGISTRY).

	// Финальный direct-список: пользовательский + community-кэш (если уже подтянут).
	let domains = assemble_domains(v.domains);
	let routing_opts = (type(v.routing_opts) == "object") ? v.routing_opts : {};
	// DNS-провайдер (фильтрация): валидность id уже проверил enum на границе; нет → дефолт каталога.
	let dns_provider = (type(v.dns_provider) == "string" && length(v.dns_provider) > 0)
		? v.dns_provider : default_provider();
	// Туннель: protocol awg (Light, дефолт) | reality | hysteria2 (Full). Валидность enum проверил
	// ubus.uc; нет → дефолт. run.uc по нему выбирает туннель-шаг (vpn/singbox) и tunnel_if.
	let protocol = (type(v.protocol) == "string" && length(v.protocol) > 0)
		? v.protocol : default_protocol();
	// Конфиг активного туннеля — по conf_key протокола (единый источник соответствия «протокол →
	// поле», см. PROTOCOLS). Конфиги остальных протоколов игнорируем: писать чужие credentials в
	// payload незачем.
	let tunnel_key = tunnel_info(protocol).conf_key;
	let tunnel_text = (type(v[tunnel_key]) == "string") ? v[tunnel_key] : "";

	// Синхронная валидация туннель-конфига: битую ссылку/конфиг отбиваем ДО фона с понятной
	// причиной (не гонять весь rollback-цикл и не заставлять читать лог).
	let vt = validate_tunnel_conf(protocol, tunnel_text);
	if (!vt.ok)
		respond(make_error(vt.error));

	// Воспроизводимая конфигурация (для set_mode/update_list/set_dns_provider/reset) — БЕЗ секретов.
	// install.json — ещё и признак «установлено» для m_status, а пишем мы его ДО исхода установки.
	// Поэтому прежний файл откладываем в .prev: run.uc на откате вернёт его (пере-установка поверх
	// рабочей), а не было прежнего — удалит новый. Иначе провалившаяся установка оставляла
	// фантомное installed=true, и мастер после отката открывал «панель» пустой системы.
	let cfg = { user_domains: v.domains ?? [], domains: domains, routing_opts: routing_opts,
		dns_provider: dns_provider, protocol: protocol };
	unlink(CFG_FILE + ".prev");
	if (access(CFG_FILE))
		sh(sprintf("cp %s %s.prev", CFG_FILE, CFG_FILE));
	save_cfg(cfg);

	// Полезная нагрузка для run.uc: его stdin-контракт {protocol, <conf_key>, root_password,
	// ssid, wifi_key, dns_provider, domains, routing_opts}. Содержит секреты (приватный ключ AWG,
	// credentials Full-сервера, пароль root, ключ Wi-Fi) → пишем и тут же сужаем права до 600.
	let payload = {
		protocol: protocol,
		root_password: v.root_password,
		ssid: v.ssid, wifi_key: v.wifi_key, dns_provider: dns_provider,
		domains: domains, routing_opts: routing_opts,
		// Пропуск soft-проверок железа (мастер спрашивает явным согласием). Только true считаем
		// согласием — отсутствие/мусор = обычный строгий гейт (fail-safe направление).
		accept_risk: (v.accept_risk === true),
	};
	payload[tunnel_key] = tunnel_text;
	writefile(PAYLOAD_FILE, sprintf("%J", payload));
	chmod(PAYLOAD_FILE, 0o600);

	// Фон: run.uc — длинная операция (apk + шаги), не держим RPC (см. spawn_bg).
	let pid = spawn_bg(sprintf("%s < %s", engine_cli("install/run.uc"), PAYLOAD_FILE), "starting");
	respond({ status: "started", pid: pid });
}

function m_install_progress() {
	let step = trim(readfile(STATE_FILE) ?? "idle");
	let running = pid_alive();

	// done-маркер = код выхода фоновой операции ("0" = ok, "cancelled" пишет install_cancel).
	// Процесс мёртв без маркера → упал (crashed).
	let done = false, result = "unknown";
	let dm = readfile(DONE_FILE);
	if (dm != null) {
		done = true;
		let m = trim(dm);
		result = (m == "0") ? "ok" : (m == "cancelled" ? "cancelled" : "fail");
	} else if (!running && access(LOG_FILE)) {
		done = true; result = "crashed";
	}

	// Хвост лога 64 КБ: покрывает целиком даже шумный лог (ретраи apk на плохой сети) — иначе
	// «Скачать журнал» в мастере молча отдавал бы обрезанное начало.
	let log = sh(sprintf("tail -c 64000 %s 2>/dev/null", LOG_FILE));
	// Код исхода (run.uc пишет через REASON_FILE): есть → UI различает причину провала.
	let resp = { step: step, running: running, done: done, result: result, log: log };
	let reason = trim(readfile(REASON_FILE) ?? "");
	if (length(reason) > 0)
		resp.reason = reason;
	respond(resp);
}

function m_set_mode(v) {
	if (pid_alive())
		respond(make_error("операция уже выполняется"));
	if (!access(CFG_FILE))
		respond(make_error("роутер не настроен — режим не к чему применять"));
	let cfg = load_cfg();
	let prev = cfg.routing_opts.mode ?? "home";
	cfg.routing_opts.mode = v.mode;

	// Mode-зависимы только firewall (kill-switch строже + ip rule) и DNS (в travel nftset пуст);
	// VPN/DoH не трогаем. Firewall читает режим из install.json, поэтому сохраняем ДО reapply и
	// возвращаем прежний при провале: install.json обязан отражать ПРИМЕНЁННОЕ состояние.
	// Порядок: сначала firewall (откажет он — система не тронута), dns после него fail-safe.
	save_cfg(cfg);
	let rc_fw  = int(trim(sh(engine_cli("install/reapply.uc") + " >/dev/null 2>&1; echo $?")));
	let rc_dns = (rc_fw == 0) ? reapply_dns(cfg) : -1;
	if (rc_fw != 0 || rc_dns != 0) {
		cfg.routing_opts.mode = prev;
		save_cfg(cfg);
		respond(make_error(rc_fw == 2 ? "WAN не найден — режим не применён, проверьте подключение к провайдеру"
		                             : sprintf("не удалось применить режим %s", v.mode),
			{ firewall: rc_fw, dns: rc_dns }));
	}
	respond({ status: "ok", mode: v.mode });
}

function m_update_list(v) {
	if (pid_alive())
		respond(make_error("операция уже выполняется"));

	// Подтянуть свежий community-список (fetch.uc сам гейтит мусор и атомарно меняет кэш;
	// при сбое кэш не тронут → остаётся старый рабочий список). Источник — DEFAULT_SOURCE в
	// list/list.uc: решение проекта, не настройка пользователя.
	let rc = int(trim(sh(engine_cli("list/fetch.uc") + " >/dev/null 2>&1; echo $?")));
	if (rc != 0)
		respond(make_error("не удалось обновить список — кэш не тронут (см. logread)"));

	// Пересобрать финальные домены (user + новый кэш) и переприменить DNS-шаг.
	let cfg = load_cfg();
	cfg.domains = assemble_domains(cfg.user_domains);
	save_cfg(cfg);
	let rc_dns = reapply_dns(cfg);
	if (rc_dns != 0)
		respond(make_error("список обновлён, но DNS-шаг не применился", { dns: rc_dns }));
	respond({ status: "ok", direct_domains: length(cfg.domains) });
}

function m_check_lan_conflict() {
	// Факты собирает тот же gather, что у preflight (lan_cidr/wan_cidr из ubus network.*);
	// детект и подбор замены — чистые cidr_overlap/suggest_lan (под юнит-тестами).
	let raw = sh(engine_cli("preflight/gather.uc"));
	let facts = (substr(trim(raw), 0, 1) == "{") ? json(raw) : {};
	if (!facts.lan_cidr || !facts.wan_cidr)
		respond({ conflict: false, reason: "WAN ещё не поднят или подсети неизвестны — проверять нечего" });
	let clash = cidr_overlap(facts.lan_cidr, facts.wan_cidr);
	respond({
		conflict: clash,
		lan_cidr: facts.lan_cidr,
		wan_cidr: facts.wan_cidr,
		suggest_ip: clash ? suggest_lan(facts.wan_cidr) : null,
	});
}

function m_apply_lan_ip(v) {
	// Токен сверен центральным гейтом (деструктив — только владелец install-токена).
	if (pid_alive())
		respond(make_error("операция уже выполняется"));

	// Граница доверия: подделанный запрос не должен уронить роутер в 0.0.0.0 (safety guard v1).
	if (!valid_lan_ip(v.ip))
		respond(make_error("ip должен быть вида 192.168.X.Y (валидные октеты, host 1..254)"));

	// На 25.12+ ipaddr хранится в CIDR-форме — сохраняем маску, меняем только адрес.
	let cur = trim(sh("uci -q get network.lan.ipaddr 2>/dev/null"));
	let sl = index(cur, "/");
	let newval = (sl >= 0) ? v.ip + substr(cur, sl) : v.ip;
	// rc проверяем: упавший set/commit (ro-fs, битый конфиг) с ответом «applied» отправил бы
	// пользователя на новый IP, которого роутер не получит (деструктив без права на молчаливый провал).
	let rc = trim(sh(sprintf("uci set network.lan.ipaddr='%s' && uci commit network; echo $?", newval)));
	if (rc != "0")
		respond(make_error("не удалось сохранить новый адрес LAN — конфигурация не изменена (см. logread)"));

	// Отложенный restart: caller успевает получить HTTP-ответ ДО разрыва сети (sleep 3);
	// setsid отвязывает от rpcd-сессии — SIGHUP при её закрытии не убьёт restart (приём v1).
	sh("setsid sh -c 'sleep 3; /etc/init.d/network restart' </dev/null >/dev/null 2>&1 &");
	respond({ status: "applied", new_ip: v.ip, restart_in: 3 });
}

function m_install_cancel(v) {
	// Токен сверен центральным гейтом (отмену контролирует владелец install-токена).
	if (!pid_alive())
		respond(make_error("установка не идёт — отменять нечего"));
	// setsid сделал фоновый sh лидером новой process-group (PGID=PID) → минус-PID убивает всю
	// группу (run.uc + дочерние apk/apply), а не только оболочку.
	let pid = trim(readfile(PID_FILE) ?? "");
	sh(sprintf("kill -TERM -%s 2>/dev/null", pid));
	// Ждём смерти группы и пишем маркер ПОСЛЕДНИМ: иначе обёртка спавна (`…; echo $? > done`)
	// может перезаписать "cancelled" своим кодом выхода, если установка завершилась в момент
	// отмены — UI показал бы «не удалась» вместо «отменена» (гонка из code-review).
	for (let i = 0; i < 10 && pid_alive(); i++)
		sh("sleep 1");
	// Группа пережила TERM (типовой случай — apk завис на сети, ради этого и отменяют) →
	// эскалация KILL: нельзя стартовать rollback ПОВЕРХ живой установки (snapshot restore
	// параллельно с применением шагов = недетерминированное полусостояние).
	if (pid_alive()) {
		sh(sprintf("kill -KILL -%s 2>/dev/null", pid));
		for (let i = 0; i < 5 && pid_alive(); i++)
			sh("sleep 1");
	}
	// Гонка «отмена против уже успевшего commit»: если установка ЗАВЕРШИЛАСЬ УСПЕХОМ, пока мы
	// ждали смерти группы (done="0" от обёртки спавна), откатывать поздно и вредно — teardown
	// снёс бы data-plane только что закоммиченной рабочей системы. Честно сообщаем.
	let dm0 = readfile(DONE_FILE);
	if (dm0 != null && trim(dm0) == "0")
		respond(make_error("установка уже завершилась успешно — отменять поздно (система работает)"));
	writefile(DONE_FILE, "cancelled\n");
	writefile(STATE_FILE, "cancelled\n");
	// Прерванная установка = частично применённые шаги. Откат — ЕДИНОЙ реализацией движка
	// (install/run.uc --rollback: snapshot restore + teardown грязных шагов), не копией здесь.
	// protocol ОБЯЗАТЕЛЕН: без него run.uc берёт дефолт awg и НЕ teardown'ит singbox —
	// отмена reality-установки оставляла бы живой sing-box с credentials (находка ревью).
	let cc = load_cfg();
	let td = sprintf("%J", { domains: [], routing_opts: cc.routing_opts, protocol: cc.protocol });
	run_stdin(engine_cli("install/run.uc") + " --rollback >/dev/null 2>&1", td);
	respond({ status: "cancelled" });
}

function m_service_restart(v) {
	// Не дёргать сервисы посреди длинной операции: рестарт awg0/dnsmasq в окне health-check
	// установки/replace валит её пробу — инвариант «PID-файл = взаимное исключение».
	if (pid_alive())
		respond(make_error("операция уже выполняется"));
	// «Туннель» — по ШАГУ активного протокола (watchdog.restart_tunnel_cmd, под юнитами):
	// у Full-тира это сервис sing-box + netifd-интерфейс, у AWG — интерфейс awg0.
	if (v.service == "vpn")
		sh(restart_tunnel_cmd(load_cfg()));
	else if (v.service == "dns")
		sh("/etc/init.d/dnsmasq restart >/dev/null 2>&1");
	else if (v.service == "doh")
		sh("/etc/init.d/https-dns-proxy restart >/dev/null 2>&1");
	respond({ status: "restarted", service: v.service });
}

// m_pause_protection / m_resume_protection — аварийный режим (см. install/pause.uc).
// Синхронно: операция короткая (снять правила + reload сети), а человек в этот момент смотрит
// в панель и ждёт ответа «получилось». Взаимный замок — тот же, что у прочих мутаций.
function toggle_protection(resume) {
	if (pid_alive())
		respond(make_error("операция уже выполняется"));
	if (!access(CFG_FILE))
		respond(make_error("роутер не настроен — аварийный режим не к чему применять"));
	let rc = sh(sprintf("%s%s >/dev/null 2>&1; echo $?",
		engine_cli("install/pause.uc"), resume ? " --resume" : ""));
	if (int(trim(rc)) != 0)
		respond(make_error(resume ? "не удалось вернуть защиту (см. logread)"
		                          : "не удалось выключить защиту (см. logread)"));
	respond({ status: "ok", paused: !resume });
}

function m_set_dns_provider(v) {
	// см. m_service_restart: не переписывать doh-секцию посреди установки/replace (snapshot
	// restore отката перетёр бы её, а health-check мог увидеть полуприменённый DNS).
	if (pid_alive())
		respond(make_error("операция уже выполняется"));
	// Сменить DNS-провайдера (= уровень фильтрации). Переприменить doh-шаг с новым id
	// (идемпотентно: та же секция cheburnet_doh переписывается) и сохранить в конфигурацию.
	let rc = run_stdin(engine_cli("steps/doh/apply.uc"), sprintf("%J", { provider: v.provider }));
	if (rc != 0)
		respond(make_error("не удалось сменить DNS-провайдера (см. logread)", { code: rc }));
	let cfg = load_cfg();
	cfg.dns_provider = v.provider;
	save_cfg(cfg);
	respond({ status: "ok", dns_provider: v.provider });
}

function m_replace_awg_conf(v) {
	if (pid_alive())
		respond(make_error("операция уже выполняется"));
	let active_awg = load_cfg().protocol;
	if (active_awg != "awg")
		respond(make_error(sprintf("активный туннель — %s; меняйте сервер того протокола или переключитесь на AmneziaWG",
			proto_name(active_awg))));
	if (length(trim(sh("uci -q get network.awg0 2>/dev/null"))) == 0)
		respond(make_error("VPN не установлен — пройдите мастер установки"));

	// Синхронная валидация .conf ДО фона: битый/обрезанный конфиг отбиваем сразу, с причиной
	// (vpn/plan.uc печатает ERROR-строки и выходит 1) — не тратим rollback-цикл.
	let rc = run_stdin(engine_cli("steps/vpn/plan.uc") + " >/dev/null 2>&1", v.awg_conf);
	if (rc != 0)
		respond(make_error("AWG-конфиг не разобран — проверьте, что вставлен целиком"));

	// Фон: replace_vpn.uc (snapshot → apply → handshake → commit/restore). Конфиг содержит
	// приватный ключ → payload 600.
	writefile(PAYLOAD_FILE, v.awg_conf);
	chmod(PAYLOAD_FILE, 0o600);
	let pid = spawn_bg(sprintf("%s < %s", engine_cli("install/replace_vpn.uc"), PAYLOAD_FILE), "replacing-vpn");
	respond({ status: "started", pid: pid });
}

// replace_singbox_conf(protocol, conf) — замена сервера Full-протокола без переустановки.
// ОДНА реализация на reality и hysteria2: у них общий config.json, общий шаг и общая проба, значит
// и защитный пояс общий (ADR 0004). Методы-обёртки различаются только именем аргумента.
function replace_singbox_conf(protocol, conf) {
	if (pid_alive())
		respond(make_error("операция уже выполняется"));
	// Гейт по АКТИВНОМУ протоколу, не по наличию /etc/config/sing-box: после кнопки «Включить
	// Full-тир» файл уже есть, а туннель ещё AWG — replace поверх живого awg0 перехватил бы весь
	// LAN-трафик half-routes'ами при NAT-зоне на awg0 (UI это гейтит, но граница доверия — ubus RPC).
	// Сверяем и с ДРУГИМ Full-протоколом: замена конфига — не смена протокола, для неё есть
	// switch_to_* (он переприменяет весь data-plane и умеет откатиться).
	let active = load_cfg().protocol;
	if (active != protocol)
		respond(make_error(sprintf("активный туннель — %s; смените конфиг того протокола или переключитесь на %s",
			proto_name(active), proto_name(protocol))));
	if (trim(sh("[ -f /etc/config/sing-box ] && echo y || true")) != "y")
		respond(make_error(sprintf("Full-тир не установлен — пройдите мастер с протоколом %s", proto_name(protocol))));

	// Синхронная валидация ссылки/конфига ДО фона: битый вход отбиваем сразу с понятной
	// причиной (нет pbk/sni/…), не тратя rollback-цикл. Тот же валидатор, что в m_install.
	let vt = validate_tunnel_conf(protocol, conf);
	if (!vt.ok)
		respond(make_error(vt.error));

	// Фон: replace_singbox.uc (бэкап config.json → snapshot → apply → probe → commit/restore).
	// Конфиг содержит credentials сервера → payload 600.
	writefile(PAYLOAD_FILE, conf);
	chmod(PAYLOAD_FILE, 0o600);
	let pid = spawn_bg(sprintf("%s < %s", engine_cli("install/replace_singbox.uc"), PAYLOAD_FILE),
		"replacing-" + protocol);
	respond({ status: "started", pid: pid });
}

function m_install_full_tier(v) {
	if (pid_alive())
		respond(make_error("операция уже выполняется"));
	if (length(trim(sh("command -v sing-box"))) > 0)
		respond(make_error("Full-тир уже установлен (sing-box стоит)"));

	// Догрузка бинаря sing-box по кнопке (opt-in Full-тир) — вынесена в install-singbox.sh (ретраи,
	// порядок предпочтения tiny→полный, код выхода по факту наличия бинаря; логика под
	// tests/install-singbox-test.sh). Один бинарь открывает ОБА Full-протокола. Не трогает
	// работающий AWG: ставит только пакет.
	let pid = spawn_bg(sprintf("sh %s/install/install-singbox.sh", ENGINE), "installing-full");
	respond({ status: "started", pid: pid });
}

// switch_tunnel(protocol, conf) — in-place смена активного туннеля на protocol.
//
// ОДНА реализация на все переходы (awg↔reality↔hysteria2): переиспользуем run.uc целиком — он
// делает snapshot → teardown НЕактивного туннеля → apply туннель+dns+doh+firewall(его интерфейс) →
// health (handshake для awg / connectivity-probe для Full) → commit/rollback. Домены/DNS/режим
// берём из сохранённого cfg (мастер НЕ проходим), пароль/Wi-Fi не трогаем.
//
// protocol в install.json меняем ЗАРАНЕЕ (+.prev): на commit run.uc допишет wan_if в этот же файл,
// на откате вернёт .prev с прежним протоколом и восстановит config.json (см. run.uc rollback_all).
// Копий этой последовательности по методам нет намеренно: три копии разъехались бы, а каждая из
// них — путь, который умеет оставить роутер без интернета.
function switch_tunnel(protocol, conf) {
	if (pid_alive())
		respond(make_error("операция уже выполняется"));
	if (!access(CFG_FILE))
		respond(make_error("система ещё не настроена — сначала пройдите мастер"));
	// Full-протоколы требуют бинаря; AWG в ядре — нет.
	if (uses_singbox(protocol) && length(trim(sh("command -v sing-box"))) == 0)
		respond(make_error("sing-box не установлен — сначала нажмите «Включить запасной туннель»"));

	let cfg = load_cfg();
	if (cfg.protocol == protocol)
		respond(make_error(sprintf("уже используется %s — меняйте сервер через замену конфига",
			proto_name(protocol))));

	// Синхронная валидация конфига ДО фона (понятная ошибка, не rollback-цикл).
	let vt = validate_tunnel_conf(protocol, conf);
	if (!vt.ok)
		respond(make_error(vt.error));

	cfg.protocol = protocol;
	unlink(CFG_FILE + ".prev");
	sh(sprintf("cp %s %s.prev", CFG_FILE, CFG_FILE));
	save_cfg(cfg);

	// domains — свежая сборка user+imported (как в m_install), а не устаревший снимок.
	// Конфиг кладём под ключом протокола (conf_key) — его же читает step_stdin в run.uc.
	let payload = {
		protocol: protocol,
		domains: assemble_domains(cfg.user_domains), routing_opts: cfg.routing_opts,
		dns_provider: cfg.dns_provider,
		accept_risk: accepted_risk(cfg),
	};
	payload[tunnel_info(protocol).conf_key] = conf;
	writefile(PAYLOAD_FILE, sprintf("%J", payload));
	chmod(PAYLOAD_FILE, 0o600);
	let pid = spawn_bg(sprintf("%s < %s", engine_cli("install/run.uc"), PAYLOAD_FILE),
		"switching-" + protocol);
	respond({ status: "started", pid: pid });
}

function m_factory_reset(v) {
	// Защитное слово против случайного клика: ровно "RESET" (как в v1).
	if (v.confirm != "RESET")
		respond(make_error('confirm должен быть ровно "RESET"'));
	if (pid_alive())
		respond(make_error("операция уже выполняется"));
	// Фон: reset.uc снимает cheburnet-конфигурацию (НЕ firstboot v1: роутер не сбрасывается).
	let pid = spawn_bg(engine_cli("install/reset.uc"), "resetting");
	respond({ status: "started", pid: pid });
}

// Диагностика для поддержки: собирает логи/состояние/версии и ВЫРЕЗАЕТ секреты (diagnostics.uc
// делает это сам, до вывода — здесь секретов уже не бывает). Отдаём текст в браузер владельца;
// никуда не отправляем — см. WHY в diagnostics.uc.
function m_diagnostics() {
	let out = sh(engine_cli("install/diagnostics.uc") + " --json 2>/dev/null");
	let parsed = null;
	try { parsed = json(trim(out)); } catch (e) { parsed = null; }
	// Сборщик не отдал JSON (упал/нет ucode-модуля) — честная ошибка вместо пустого файла:
	// пустой пакет человек отправит и будет ждать помощи, которой по нему не оказать.
	if (type(parsed) != "object" || type(parsed.text) != "string")
		respond(make_error("не удалось собрать диагностику (см. logread)"));
	respond({ status: "ok", text: parsed.text, removed: parsed.removed ?? [] });
}

// Install-токен для повторной настройки: отдаём существующий, а нет — выпускаем. Единственное
// место выпуска после bootstrap'а (reset.uc намеренно этого не делает — см. WHY в ubus.uc).
// Права 0600 ставим ДО записи значения: иначе секрет успевает полежать с правами по умолчанию.
function m_install_token() {
	let tok = trim(readfile(TOKEN_FILE) ?? "");
	if (length(tok) == 0) {
		mkdir(ETC_CHEBURNET, 0o700); // существует → false, это норма (каталог мог остаться)
		writefile(TOKEN_FILE, "");
		chmod(TOKEN_FILE, 0o600);
		// UUID ядра — тот же источник и формат, что у bootstrap.sh. Нет /proc → hex из urandom
		// тем же способом, что в bootstrap (единый формат токена в проекте).
		tok = trim(readfile("/proc/sys/kernel/random/uuid") ?? "");
		if (length(tok) == 0)
			tok = trim(sh("tr -dc 'a-f0-9' < /dev/urandom | head -c 32"));
		if (length(tok) == 0)
			respond(make_error("не удалось выпустить install-токен (нет источника случайности)"));
		writefile(TOKEN_FILE, tok + "\n");
	}
	respond({ status: "ok", token: tok });
}

// === точка входа: rpcd `list` / `call <method>` ===

let action = (length(ARGV) > 0) ? ARGV[0] : "";

if (action == "list") {
	print(sprintf("%J\n", list_descriptor()));
	exit(0);
}
if (action != "call") {
	warn('{"error":"unknown action"}\n');
	exit(1);
}

let method = (length(ARGV) > 1) ? ARGV[1] : "";
let raw = trim(stdin.read("all") ?? "");
let args = (substr(raw, 0, 1) == "{") ? json(raw) : {};

// Каталоги состояния обязаны существовать ДО любого метода — иначе writefile молча падает
// (класс бага, пойманный живым прогоном: install «висел» на state=idle с пустым payload):
//   • STATE_DIR (/tmp/cheburnet) — payload/state/log/done фоновых операций. /tmp это tmpfs →
//     исчезает после reboot, поэтому mkdir здесь (на каждом вызове), а не в postinst пакета.
//   • ETC_CHEBURNET (/etc/cheburnet) — install.json (replay для set_mode/update_list). Его
//     создаёт bootstrap, но reset.uc его удаляет → без гарантии save_cfg писал бы в никуда.
// mkdir -p идемпотентен и дёшев.
sh(sprintf("mkdir -p %s %s 2>/dev/null", STATE_DIR, ETC_CHEBURNET));

// Граница доверия: валидируем вход чистым ядром ДО любого I/O.
let vr = validate_request(method, args);
if (!vr.ok)
	respond(make_error(vr.error));
let v = vr.value;

// Токен-гейт — ЦЕНТРАЛЬНО, по флагу token из REGISTRY (единый источник с валидацией/ACL):
// ручные вызовы check_token в обработчиках дрейфуют — новый token:true-метод без ручного
// вызова был бы тихим обходом гейта. check_token при провале отвечает и не возвращается.
if (requires_token(method))
	check_token(v);

if (method == "preflight")                  m_preflight();
else if (method == "status")                m_status();
else if (method == "check_lan_conflict")    m_check_lan_conflict();
else if (method == "apply_lan_ip")          m_apply_lan_ip(v);
else if (method == "install")               m_install(v);
else if (method == "install_progress")      m_install_progress();
else if (method == "install_cancel")        m_install_cancel(v);
else if (method == "set_mode")              m_set_mode(v);
else if (method == "update_list")           m_update_list(v);
else if (method == "service_restart")       m_service_restart(v);
else if (method == "pause_protection")      toggle_protection(false);
else if (method == "resume_protection")     toggle_protection(true);
else if (method == "set_dns_provider")      m_set_dns_provider(v);
else if (method == "replace_awg_conf")      m_replace_awg_conf(v);
// Замена сервера и смена туннеля — тонкие обёртки над ОДНОЙ реализацией каждая: различаются
// только протоколом и именем аргумента (оно же — имя формата конфига).
else if (method == "replace_reality_conf")    replace_singbox_conf("reality", v.reality_conf);
else if (method == "replace_hysteria2_conf")  replace_singbox_conf("hysteria2", v.hysteria2_conf);
else if (method == "install_full_tier")     m_install_full_tier(v);
else if (method == "switch_to_reality")     switch_tunnel("reality", v.reality_conf);
else if (method == "switch_to_hysteria2")   switch_tunnel("hysteria2", v.hysteria2_conf);
else if (method == "switch_to_awg")         switch_tunnel("awg", v.awg_conf);
else if (method == "diagnostics")           m_diagnostics();
else if (method == "install_token")         m_install_token();
else if (method == "factory_reset")         m_factory_reset(v);
else respond(make_error("unknown method")); // недостижимо: validate_request уже отсёк
